{
  "name": "investor-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "White-label investor app — installable PWA and desktop client for the platform",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run apply-company && tsc -b && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "apply-company": "tsx scripts/apply-company.ts",
    "icons": "tsx scripts/generate-icons.ts",
    "screenshots": "tsx scripts/screenshots.ts",
    "lhci": "lhci autorun --config=lighthouserc.json",
    "audit:deps": "npm audit --audit-level=high",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "@fontsource-variable/inter-tight": "^5.2.0",
    "@fontsource-variable/jetbrains-mono": "^5.2.0",
    "@fontsource/instrument-serif": "^5.2.0",
    "@hookform/resolvers": "^5.2.0",
    "@tanstack/react-query": "^5.104.0",
    "idb-keyval": "^6.2.2",
    "lucide-react": "^0.560.0",
    "pdfmake": "^0.2.21",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.65.0",
    "react-router": "^7.9.0",
    "recharts": "^3.10.1",
    "sonner": "^2.0.7",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@eslint/js": "^9.39.0",
    "@lhci/cli": "0.13.0",
    "@playwright/test": "~1.56.0",
    "@testing-library/jest-dom": "^6.9.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.0",
    "@types/node": "^22.19.0",
    "@types/pdfmake": "^0.2.11",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.1.0",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.0.0",
    "fake-indexeddb": "^6.2.0",
    "jsdom": "^27.0.0",
    "prettier": "^3.6.0",
    "sharp": "^0.35.5",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0",
    "vite": "^8.3.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.3",
    "workbox-precaching": "^7.3.0",
    "workbox-routing": "^7.3.0",
    "workbox-window": "^7.3.0"
  }
}
