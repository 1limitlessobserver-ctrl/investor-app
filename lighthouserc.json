{
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "isSinglePageApplication": true,
      "url": ["http://localhost/sign-in"],
      "numberOfRuns": 1,
      "settings": { "preset": "desktop", "chromeFlags": "--no-sandbox" }
    },
    "assert": {
      "assertions": {
        "installable-manifest": "error",
        "maskable-icon": "error",
        "themed-omnibox": "warn"
      }
    },
    "upload": { "target": "filesystem", "outputDir": ".lighthouseci" }
  }
}
